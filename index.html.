<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تحدّي محافظات الأردن</title>
<style>
:root{
  --red:#CE1126;
  --green:#007A3D;
  --black:#151515;
  --white:#FFFFFF;
  --soft:#f6f7f5;
  --line:#d9dfda;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Tahoma,Arial,sans-serif;
  background:linear-gradient(135deg,#f4f6f4,#fff 55%,#f3f7f3);
  color:var(--black);
  min-height:100vh;
}
header{
  padding:20px 14px 16px;
  text-align:center;
  color:var(--white);
  background:var(--black);
  border-top:7px solid var(--red);
  border-bottom:7px solid var(--green);
  position:relative;
}
header:after{
  content:"";
  display:block;
  height:5px;
  width:min(220px,55%);
  margin:13px auto 0;
  background:linear-gradient(to left,var(--green) 0 25%,var(--white) 25% 50%,var(--black) 50% 75%,var(--red) 75% 100%);
  border-radius:10px;
}
h1{margin:0;font-size:clamp(23px,4vw,38px);letter-spacing:.1px}
header p{margin:8px 0 0;font-size:clamp(13px,2vw,17px);color:#f0f0f0}
.wrap{max-width:1250px;margin:auto;padding:14px}
.topbar{display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:wrap;margin:4px 0 14px}
.pill{
  background:var(--white);
  border:2px solid var(--black);
  border-radius:30px;
  padding:8px 15px;
  font-weight:bold;
  box-shadow:0 3px 0 #d9dfda;
}
button{font-family:inherit;cursor:pointer}
.action{
  border:0;border-radius:22px;padding:10px 17px;font-weight:bold;
  background:var(--green);color:white;box-shadow:0 4px 0 #005b2d;
}
.action.secondary{background:white;color:var(--black);border:2px solid var(--black);box-shadow:0 3px 0 #d9dfda}
.action.reset{background:var(--red);color:white;box-shadow:0 4px 0 #920d1b}
.game{display:grid;grid-template-columns:minmax(250px,.82fr) minmax(360px,1.5fr);gap:16px;align-items:stretch}
.panel{
  background:rgba(255,255,255,.96);
  border:2px solid var(--line);
  border-top:5px solid var(--green);
  border-radius:22px;padding:14px;
  box-shadow:0 8px 20px #1515150d;
}
.panel h2{font-size:20px;margin:0 0 10px;text-align:center;color:var(--black)}
.hint{text-align:center;color:#555;font-size:14px;line-height:1.7;margin:0 0 12px}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.card{
  border:2px solid var(--green);background:#fff;border-radius:13px;padding:12px 7px;
  text-align:center;font-weight:bold;font-size:16px;color:var(--black);
  box-shadow:0 3px 0 #dce9df;touch-action:none;user-select:none;
}
.card:active,.card.selected{background:#fff0f1;border-color:var(--red);transform:translateY(2px);box-shadow:0 1px 0 #e5c9cc}
.card.done{opacity:.48;text-decoration:line-through;pointer-events:none;background:#e8f5ed;border-color:var(--green)}
.map-panel{position:relative;overflow:hidden;background:#fff}
.map-title{text-align:center;font-size:20px;font-weight:bold;margin:0 0 4px}
.map-sub{text-align:center;color:#555;font-size:13px;margin:0 0 10px;line-height:1.6}
.map-frame{
  position:relative;width:min(100%,690px);margin:0 auto;
  aspect-ratio:1280 / 1409;background:#f3f3f3;border:2px solid #d5d9d5;
  border-radius:12px;overflow:hidden;
}
.map-frame img{display:block;width:100%;height:100%;object-fit:fill}
.map-frame svg{position:absolute;inset:0;width:100%;height:100%;display:block;overflow:visible}
.drag-ghost{position:fixed;z-index:30;pointer-events:none;opacity:.92;transform:translate(-50%,-50%);padding:10px 16px;border:2px solid #CE1126;border-radius:13px;background:#fff;color:#151515;font-weight:bold;box-shadow:0 8px 24px #0003;white-space:nowrap}
.region{
  fill:rgba(255,255,255,0);
  stroke:transparent;stroke-width:7;
  cursor:pointer;pointer-events:all;
  transition:fill .15s,stroke .15s;
}
.region:hover,.region:focus{
  fill:rgba(206,17,38,.15);stroke:var(--red);stroke-dasharray:14 10;outline:none;
}
.region.correct{fill:rgba(0,122,61,.28);stroke:var(--green);stroke-width:8;cursor:default}
.zone-label{
  font-size:25px;font-weight:bold;fill:var(--black);
  stroke:#fff;stroke-width:5px;paint-order:stroke;
  pointer-events:none;text-anchor:middle;
}
.feedback{min-height:45px;text-align:center;font-weight:bold;font-size:19px;color:var(--green);padding:9px 5px;line-height:1.5}
.footer{text-align:center;color:#555;font-size:12px;margin:10px 0}
#confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:9}
.conf{position:absolute;top:-15px;width:9px;height:15px;animation:fall 1.7s linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(650deg);opacity:.2}}
.modal{display:none;position:fixed;inset:0;background:#101010d9;z-index:10;align-items:center;justify-content:center;padding:18px}
.modal.show{display:flex}
.modalbox{
  background:#fff;border:5px solid var(--green);border-top:8px solid var(--red);
  border-radius:26px;padding:28px;text-align:center;max-width:440px;width:100%;
  box-shadow:0 15px 50px #0004;
}
.modalbox h2{font-size:28px;margin:0 0 10px;color:var(--green)}
.modalbox p{font-size:19px;line-height:1.8}
@media(max-width:760px){
  .game{grid-template-columns:1fr}
  .map-panel{order:1}.cards-panel{order:2}
  .cards{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:460px){
  .cards{grid-template-columns:repeat(2,1fr)}
  .card{font-size:14px;padding:10px 4px}
  .wrap{padding:9px}
  .panel{padding:10px}
}
</style>
</head>
<body>
<header>
  <h1>🇯🇴 تحدّي محافظات الأردن 🇯🇴</h1>
  <p>مطابقة أسماء المحافظات مع مواقعها على الخريطة</p>
</header>

<div class="wrap">
  <div class="topbar">
    <span class="pill" id="progress">⭐ 0 من 12</span>
    <span class="pill" id="score">الإجابات الصحيحة: 0</span>
    <button class="action secondary" id="soundBtn">🔊 الصوت والموسيقى يعملان</button>
    <button class="action reset" id="resetBtn">↻ إعادة اللعب</button>
  </div>

  <div class="game">
    <section class="panel cards-panel">
      <h2>🗂️ بطاقات المحافظات</h2>
      <p class="hint">يمكن سحب البطاقة وإفلاتها على موقع المحافظة، أو اختيار البطاقة ثم لمس موقعها على الخريطة.</p>
      <div class="cards" id="cards"></div>
    </section>

    <section class="panel map-panel">
      <p class="map-title">خريطة المملكة الأردنية الهاشمية</p>
      <p class="map-sub">يُرجى النقر على المنطقة التي تمثّل المحافظة المختارة</p>
      <div class="map-frame">
        <img src="data:image/png;base64," alt="خريطة الأردن المرفقة مع حدود المحافظات">
        <svg viewBox="0 0 1280 1409" role="group" aria-label="مناطق تفاعلية لاختيار المحافظات">
          <!-- مناطق النقر موضوعة فوق مواقع المحافظات على الخريطة المرفقة -->
          <circle class="region" data-id="irbid" cx="270" cy="340" r="54" tabindex="0" aria-label="إربد"/>
          <circle class="region" data-id="ajloun" cx="235" cy="405" r="31" tabindex="0" aria-label="عجلون"/>
          <circle class="region" data-id="jerash" cx="294" cy="410" r="31" tabindex="0" aria-label="جرش"/>
          <circle class="region" data-id="mafraq" cx="720" cy="430" r="145" tabindex="0" aria-label="المفرق"/>
          <circle class="region" data-id="balqa" cx="220" cy="505" r="40" tabindex="0" aria-label="البلقاء"/>
          <circle class="region" data-id="zarqa" cx="355" cy="515" r="57" tabindex="0" aria-label="الزرقاء"/>
          <circle class="region" data-id="madaba" cx="230" cy="645" r="43" tabindex="0" aria-label="مادبا"/>
          <circle class="region" data-id="amman" cx="355" cy="665" r="72" tabindex="0" aria-label="العاصمة عمّان"/>
          <circle class="region" data-id="karak" cx="255" cy="855" r="60" tabindex="0" aria-label="الكرك"/>
          <circle class="region" data-id="tafilah" cx="210" cy="1010" r="53" tabindex="0" aria-label="الطفيلة"/>
          <circle class="region" data-id="maan" cx="620" cy="1080" r="150" tabindex="0" aria-label="معان"/>
          <circle class="region" data-id="aqaba" cx="180" cy="1280" r="62" tabindex="0" aria-label="العقبة"/>
        </svg>
      </div>
      <div class="feedback" id="feedback" aria-live="polite">للبدء، يتم اختيار بطاقة من قائمة المحافظات.</div>
    </section>
  </div>
  <p class="footer">نشاط تعليمي تفاعلي للتعرّف إلى محافظات الأردن ومواقعها</p>
</div>

<div id="confetti"></div>
<div class="modal" id="finish">
  <div class="modalbox">
    <h2>🏆 اكتمل التحدّي بنجاح! 🏆</h2>
    <p>تم تحديد مواقع المحافظات الاثنتي عشرة بنجاح.<br><strong>12 من 12 نجمة ⭐</strong></p>
    <button class="action" id="again">إعادة اللعب</button>
  </div>
</div>

<script>
const govs=[
  {id:'irbid',name:'إربد'},{id:'ajloun',name:'عجلون'},{id:'jerash',name:'جرش'},
  {id:'mafraq',name:'المفرق'},{id:'balqa',name:'البلقاء'},{id:'zarqa',name:'الزرقاء'},
  {id:'madaba',name:'مادبا'},{id:'amman',name:'العاصمة عمّان'},{id:'karak',name:'الكرك'},
  {id:'tafilah',name:'الطفيلة'},{id:'maan',name:'معان'},{id:'aqaba',name:'العقبة'}
];

let selected=null,score=0,soundOn=true,dragged=null;
let touchDrag=null,dragGhost=null,suppressCardClick=false;
const cards=document.getElementById('cards'),feedback=document.getElementById('feedback');

function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function renderCards(){
  cards.innerHTML='';
  shuffle(govs).forEach(g=>{
    const b=document.createElement('button');
    b.className='card';b.textContent=g.name;b.dataset.id=g.id;b.draggable=true;
    b.addEventListener('click',()=>{if(suppressCardClick){suppressCardClick=false;return;}selectCard(b);});
    b.addEventListener('dragstart',e=>{dragged=b;e.dataTransfer.setData('text/plain',g.id);});
    // Touch/pen dragging for tablets and phones; a simple tap still selects the card.
    b.addEventListener('pointerdown',e=>{
      if(e.pointerType==='mouse')return;
      touchDrag={card:b,startX:e.clientX,startY:e.clientY,pointerId:e.pointerId,moved:false};
    });
    cards.appendChild(b);
  });
}
function selectCard(b){
  if(b.classList.contains('done'))return;
  document.querySelectorAll('.card').forEach(x=>x.classList.remove('selected'));
  selected=b;b.classList.add('selected');
  feedback.textContent='تم اختيار محافظة '+b.textContent+'. يمكن الآن تحديد موقعها على الخريطة.';
}

function clearTouchDrag(){
  if(dragGhost){dragGhost.remove();dragGhost=null;}
  touchDrag=null;
}
document.addEventListener('pointermove',e=>{
  if(!touchDrag||e.pointerId!==touchDrag.pointerId)return;
  const dx=e.clientX-touchDrag.startX,dy=e.clientY-touchDrag.startY;
  if(!touchDrag.moved&&Math.hypot(dx,dy)>8){
    touchDrag.moved=true;
    dragGhost=document.createElement('div');dragGhost.className='drag-ghost';
    dragGhost.textContent=touchDrag.card.textContent;document.body.appendChild(dragGhost);
  }
  if(touchDrag.moved){
    e.preventDefault();
    dragGhost.style.left=e.clientX+'px';dragGhost.style.top=e.clientY+'px';
  }
},{passive:false});
document.addEventListener('pointerup',e=>{
  if(!touchDrag||e.pointerId!==touchDrag.pointerId)return;
  const state=touchDrag;
  if(state.moved){
    suppressCardClick=true;
    const target=document.elementFromPoint(e.clientX,e.clientY);
    const region=target&&target.closest?target.closest('.region'):null;
    if(region){selectCard(state.card);dropOn(region);}
    else{feedback.textContent='تم تحريك البطاقة. أفلِتها فوق موقع المحافظة على الخريطة.';}
    setTimeout(()=>{suppressCardClick=false;},250);
  }
  clearTouchDrag();
});
document.addEventListener('pointercancel',clearTouchDrag);

let audioCtx=null,musicTimer=null,musicStep=0,musicStarted=false;
function getAudio(){
  const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;
  if(!audioCtx)audioCtx=new C();
  if(audioCtx.state==='suspended')audioCtx.resume();
  return audioCtx;
}
function clap(){
  const c=getAudio();if(!c)return;
  for(let k=0;k<18;k++){
    const duration=.045+Math.random()*.055;
    const buffer=c.createBuffer(1,Math.floor(c.sampleRate*duration),c.sampleRate),data=buffer.getChannelData(0);
    for(let i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*Math.pow(1-i/data.length,2);
    const src=c.createBufferSource(),gain=c.createGain(),filter=c.createBiquadFilter();src.buffer=buffer;
    filter.type='highpass';filter.frequency.value=900+Math.random()*1500;
    const t=c.currentTime+k*.055;gain.gain.setValueAtTime(.0001,t);gain.gain.exponentialRampToValueAtTime(.12,t+.008);
    gain.gain.exponentialRampToValueAtTime(.0001,t+duration);src.connect(filter);filter.connect(gain);gain.connect(c.destination);src.start(t);
  }
}
function chime(correct){
  const c=getAudio();if(!c)return;const notes=correct?[659,784,988]:[220,196];
  notes.forEach((freq,i)=>{
    const o=c.createOscillator(),g=c.createGain(),t=c.currentTime+i*.12;o.type='sine';o.frequency.value=freq;
    o.connect(g);g.connect(c.destination);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.09,t+.02);
    g.gain.exponentialRampToValueAtTime(.0001,t+.28);o.start(t);o.stop(t+.3);
  });
}
function sound(correct){
  if(!soundOn)return;
  if(correct){clap();chime(true);}else chime(false);
  if(correct&&'speechSynthesis'in window){
    const u=new SpeechSynthesisUtterance('إجابة صحيحة');u.lang='ar';u.rate=.9;
    window.speechSynthesis.cancel();window.speechSynthesis.speak(u);
  }
}
const folkNotes=[392,440,494,523,494,440,392,330,392,440,494,587,523,494,440,392];
function playMusicNote(){
  if(!soundOn||!audioCtx)return;
  const c=audioCtx,f=folkNotes[musicStep%folkNotes.length],t=c.currentTime;
  const o=c.createOscillator(),g=c.createGain();o.type='triangle';o.frequency.value=f;
  g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.035,t+.04);g.gain.exponentialRampToValueAtTime(.0001,t+.34);
  o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+.36);
  if(musicStep%2===0){
    const bass=c.createOscillator(),bg=c.createGain();bass.type='sine';bass.frequency.value=[196,220,165,196][Math.floor(musicStep/2)%4];
    bg.gain.setValueAtTime(.0001,t);bg.gain.exponentialRampToValueAtTime(.018,t+.03);bg.gain.exponentialRampToValueAtTime(.0001,t+.3);
    bass.connect(bg);bg.connect(c.destination);bass.start(t);bass.stop(t+.32);
  }
  musicStep++;
}
function startMusic(){if(!soundOn||musicStarted)return;if(!getAudio())return;musicStarted=true;playMusicNote();musicTimer=setInterval(playMusicNote,390);}
function stopMusic(){if(musicTimer)clearInterval(musicTimer);musicTimer=null;musicStarted=false;}
document.addEventListener('pointerdown',()=>{if(soundOn)startMusic();},{once:true});

function confetti(){
  const box=document.getElementById('confetti');box.innerHTML='';
  const colors=['#CE1126','#007A3D','#151515','#FFFFFF'];
  for(let i=0;i<55;i++){
    const d=document.createElement('i');d.className='conf';d.style.left=Math.random()*100+'%';
    d.style.background=colors[i%4];d.style.border=colors[i%4]==='#FFFFFF'?'1px solid #aaa':'0';
    d.style.animationDelay=Math.random()*.5+'s';box.appendChild(d);
  }
  setTimeout(()=>box.innerHTML='',2300);
}
function update(){
  document.getElementById('progress').textContent='⭐ '+score+' من 12';
  document.getElementById('score').textContent='الإجابات الصحيحة: '+score;
}
function dropOn(region){
  if(!selected){feedback.textContent='يُرجى اختيار بطاقة محافظة أولاً.';return;}
  const target=region.dataset.id;
  if(target===selected.dataset.id){
    region.classList.add('correct');
    const label=document.createElementNS('http://www.w3.org/2000/svg','text');
    label.setAttribute('x',region.getAttribute('cx'));
    label.setAttribute('y',Number(region.getAttribute('cy'))+8);
    label.setAttribute('class','zone-label');
    label.textContent=selected.textContent;
    region.parentNode.appendChild(label);
    selected.classList.add('done');selected.classList.remove('selected');selected=null;
    score++;update();sound(true);confetti();
    feedback.textContent='إجابة صحيحة! ممتاز.';
    if(score===12)setTimeout(()=>{
      document.getElementById('finish').classList.add('show');
      if(soundOn){clap();setTimeout(clap,550);}
    },800);
  }else{
    sound(false);
    feedback.textContent='الموقع غير صحيح. يمكن المحاولة مرة أخرى.';
    region.animate([{filter:'brightness(1)'},{filter:'brightness(.78)'},{filter:'brightness(1)'}],{duration:350});
  }
}
document.querySelectorAll('.region').forEach(r=>{
  r.addEventListener('click',()=>dropOn(r));
  r.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();dropOn(r);}});
  r.addEventListener('dragover',e=>e.preventDefault());
  r.addEventListener('drop',e=>{
    e.preventDefault();
    const id=e.dataTransfer.getData('text/plain');
    const b=[...document.querySelectorAll('.card')].find(x=>x.dataset.id===id);
    if(b&&!b.classList.contains('done')){selectCard(b);dropOn(r);}
  });
});
function reset(){
  score=0;selected=null;
  document.querySelectorAll('.region').forEach(r=>r.classList.remove('correct'));
  document.querySelectorAll('.zone-label').forEach(x=>x.remove());
  document.getElementById('finish').classList.remove('show');
  feedback.textContent='للبدء، يتم اختيار بطاقة من قائمة المحافظات.';
  update();renderCards();
}
document.getElementById('resetBtn').onclick=reset;
document.getElementById('again').onclick=reset;
document.getElementById('soundBtn').onclick=()=>{
  soundOn=!soundOn;
  if(soundOn){
    startMusic();document.getElementById('soundBtn').textContent='🔊 الصوت والموسيقى يعملان';
  }else{
    stopMusic();if('speechSynthesis'in window)window.speechSynthesis.cancel();
    document.getElementById('soundBtn').textContent='🔇 الصوت والموسيقى مغلقان';
  }
};
renderCards();update();
</script>
</body>
</html>